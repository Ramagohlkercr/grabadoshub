# Environment configuration for GrabadosHub Backend

NODE_ENV=development
PORT=4000

# MongoDB Connection (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/grabadoshub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/grabadoshub

# Better Auth Configuration
BETTER_AUTH_SECRET=generate_a_random_32_character_string_here_for_production
BETTER_AUTH_URL=http://localhost:4000

# Frontend URL (for CORS and OAuth redirect)
# Local: http://localhost:5173
# Production (Render): https://grabadoshub-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# GitHub OAuth Credentials (Optional in local dev, required for GitHub login)
# Obtain from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
